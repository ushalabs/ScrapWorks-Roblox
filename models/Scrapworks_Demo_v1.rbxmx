    <Item class="Script" referent="RBX0000000000000000000000000000016B">
      <Properties>
        <string name="Name">ScrapworksServer</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- SCRAPWORKS DEMO v1 | session-only scrap collection and refinery
-- Everything stays inside this imported model. No external modules or asset IDs.
local Players = game:GetService("Players")
local Demo = script.Parent
local Nodes = Demo:WaitForChild("ScrapNodes")
local Refinery = Demo:WaitForChild("Refinery")
local Terminal = Refinery:WaitForChild("SellTerminal")

local CAPACITY = 5
local RESPAWN_SECONDS = 8
local PRICES = { Steel = 15, Copper = 25, Circuit = 40 }

local function notify(player, message)
    player:SetAttribute("SW_Notice", message)
    player:SetAttribute("SW_NoticeVersion", (player:GetAttribute("SW_NoticeVersion") or 0) + 1)
end

local function getCash(player)
    local stats = player:FindFirstChild("leaderstats")
    return stats and stats:FindFirstChild("Cash")
end

local function setup(player)
    if player:GetAttribute("SW_DemoReady") then return end
    player:SetAttribute("SW_DemoReady", true)
    player:SetAttribute("SW_Carry", 0)
    player:SetAttribute("SW_CarryValue", 0)
    player:SetAttribute("SW_Notice", "Welcome! Collect 5 scraps, then use the refinery.")
    player:SetAttribute("SW_NoticeVersion", 1)

    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then
        leaderstats = Instance.new("Folder")
        leaderstats.Name = "leaderstats"
        leaderstats.Parent = player
    end
    local cash = leaderstats:FindFirstChild("Cash")
    if not cash then
        cash = Instance.new("IntValue")
        cash.Name = "Cash"
        cash.Value = 0
        cash.Parent = leaderstats
    end

    task.spawn(function()
        local gui = player:WaitForChild("PlayerGui", 15)
        local template = Demo:FindFirstChild("ScrapworksHUD")
        if gui and template and not gui:FindFirstChild("ScrapworksHUD") then
            template:Clone().Parent = gui
        end
    end)
end

Players.PlayerAdded:Connect(setup)
for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(setup, player)
end

local function withinRange(player, part, maxDistance)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    return root ~= nil and (root.Position - part.Position).Magnitude <= maxDistance
end

for _, node in ipairs(Nodes:GetChildren()) do
    if node:IsA("Model") then
        local core = node:FindFirstChild("Core")
        if core and core:IsA("BasePart") then
            local kind = string.match(node.Name, '^Scrap_(%a+)_') or "Steel"
            local price = PRICES[kind] or 15
            local prompt = Instance.new("ProximityPrompt")
            prompt.Name = "CollectScrap"
            prompt.ObjectText = kind .. " Scrap (+$" .. tostring(price) .. ")"
            prompt.ActionText = "Collect"
            prompt.KeyboardKeyCode = Enum.KeyCode.E
            prompt.HoldDuration = 0.3
            prompt.MaxActivationDistance = 9
            prompt.RequiresLineOfSight = false
            prompt.Parent = core

            local busy = false
            local appearance = {}
            for _, obj in ipairs(node:GetDescendants()) do
                if obj:IsA("BasePart") then
                    appearance[obj] = { obj.Transparency, obj.CanCollide }
                end
            end

            prompt.Triggered:Connect(function(player)
                if busy or not withinRange(player, core, 12) then return end
                setup(player)
                local carrying = player:GetAttribute("SW_Carry") or 0
                if carrying >= CAPACITY then
                    notify(player, "Bag full (5/5)! Sell at the cyan refinery terminal.")
                    return
                end
                busy = true
                player:SetAttribute("SW_Carry", carrying + 1)
                player:SetAttribute("SW_CarryValue", (player:GetAttribute("SW_CarryValue") or 0) + price)
                notify(player, "Collected " .. kind .. " scrap! +$" .. tostring(price) .. " sale value")

                prompt.Enabled = false
                for part, old in pairs(appearance) do
                    if part.Parent then
                        part.Transparency = 1
                        part.CanCollide = false
                    end
                end
                task.delay(RESPAWN_SECONDS, function()
                    for part, old in pairs(appearance) do
                        if part.Parent then
                            part.Transparency = old[1]
                            part.CanCollide = old[2]
                        end
                    end
                    if prompt.Parent then prompt.Enabled = true end
                    busy = false
                end)
            end)
        end
    end
end

local sellPrompt = Instance.new("ProximityPrompt")
sellPrompt.Name = "SellScrap"
sellPrompt.ObjectText = "SCRAP REFINERY"
sellPrompt.ActionText = "PROCESS & SELL"
sellPrompt.KeyboardKeyCode = Enum.KeyCode.E
sellPrompt.HoldDuration = 0.5
sellPrompt.MaxActivationDistance = 12
sellPrompt.RequiresLineOfSight = false
sellPrompt.Parent = Terminal
sellPrompt.Triggered:Connect(function(player)
    if not withinRange(player, Terminal, 16) then return end
    setup(player)
    local count = player:GetAttribute("SW_Carry") or 0
    if count <= 0 then
        notify(player, "No scrap in your bag — collect some first!")
        return
    end
    local value = player:GetAttribute("SW_CarryValue") or 0
    local cash = getCash(player)
    if not cash then return end
    cash.Value += value
    player:SetAttribute("SW_Carry", 0)
    player:SetAttribute("SW_CarryValue", 0)
    notify(player, "REFINED " .. tostring(count) .. " SCRAP • +$" .. tostring(value) .. " CASH!")
end)

local function signOn(part, caption, accent)
    local gui = Instance.new("SurfaceGui")
    gui.Name = "MachineSignage"
    gui.Face = Enum.NormalId.Back
    gui.LightInfluence = 0
    gui.PixelsPerStud = 45
    gui.AlwaysOnTop = false
    gui.Parent = part
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1,1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.TextColor3 = accent
    label.TextStrokeColor3 = Color3.fromRGB(7,20,25)
    label.TextStrokeTransparency = .15
    label.Text = caption
    label.Parent = gui
end
local mainSign = Refinery:FindFirstChild("RefinerySign")
if mainSign then signOn(mainSign,"SCRAP REFINERY",Color3.fromRGB(73,235,217)) end
local intro = Demo:FindFirstChild("Environment")
if intro then
    local hangar = intro:FindFirstChild("HangarBackWall")
    if hangar then signOn(hangar,"SCRAPWORKS  |  SALVAGE BAY",Color3.fromRGB(255,210,108)) end
end
print("[Scrapworks demo] Loaded successfully: 9 scrap nodes, refinery, per-player HUD, session cash.")
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="LocalScript" referent="RBX0000000000000000000000000000016C">
      <Properties>
        <string name="Name">ScrapworksHUD</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- SCRAPWORKS DEMO v1 HUD | Runs only after server clones into PlayerGui
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
if not player then return end
local playerGui = player:WaitForChild("PlayerGui")

local function panel(parent, name, size, position, anchor, color, radius)
    local frame = Instance.new("Frame")
    frame.Name = name
    frame.AnchorPoint = anchor
    frame.Size = size
    frame.Position = position
    frame.BackgroundColor3 = color
    frame.BackgroundTransparency = .06
    frame.BorderSizePixel = 0
    frame.Parent = parent
    local corner=Instance.new("UICorner")
    corner.CornerRadius=UDim.new(0,radius)
    corner.Parent=frame
    local stroke=Instance.new("UIStroke")
    stroke.Color=Color3.fromRGB(65,124,138)
    stroke.Thickness=1.4
    stroke.Transparency=.30
    stroke.Parent=frame
    return frame
end
local function label(parent, name, text, size, pos, color, font, fontsize)
    local t=Instance.new("TextLabel")
    t.Name=name
    t.Text=text
    t.Size=size
    t.Position=pos
    t.BackgroundTransparency=1
    t.Font=font or Enum.Font.GothamBold
    t.TextColor3=color
    t.TextSize=fontsize or 18
    t.TextXAlignment=Enum.TextXAlignment.Left
    t.TextYAlignment=Enum.TextYAlignment.Center
    t.Parent=parent
    return t
end

local gui=Instance.new("ScreenGui")
gui.Name="ScrapworksHUDScreen"
gui.ResetOnSpawn=false
gui.IgnoreGuiInset=false
gui.DisplayOrder=10
gui.Parent=script.Parent

local header=panel(gui,"TopBrand",UDim2.new(0,335,0,54),UDim2.new(.5,0,0,22),Vector2.new(.5,0),Color3.fromRGB(16,31,42),12)
local h=label(header,"Title","SCRAPWORKS  /  FIELD TEST",UDim2.new(1,-34,1,0),UDim2.fromOffset(17,0),Color3.fromRGB(91,241,226),Enum.Font.GothamBlack,19)
h.TextXAlignment=Enum.TextXAlignment.Center

local stats=panel(gui,"InventoryPanel",UDim2.new(0,290,0,116),UDim2.new(0,20,1,-22),Vector2.new(0,1),Color3.fromRGB(17,27,39),14)
label(stats,"Sub","INVENTORY / DEMO v1",UDim2.new(1,-28,0,27),UDim2.fromOffset(16,10),Color3.fromRGB(129,178,193),Enum.Font.GothamBold,12)
local carried=label(stats,"Carry","SCRAP    0 / 5",UDim2.new(1,-30,0,30),UDim2.fromOffset(16,39),Color3.fromRGB(238,247,249),Enum.Font.GothamBold,22)
local cashText=label(stats,"Cash","CASH    $0",UDim2.new(1,-30,0,26),UDim2.fromOffset(16,74),Color3.fromRGB(255,210,113),Enum.Font.GothamBold,21)

local tip=panel(gui,"InfoToast",UDim2.new(0,430,0,52),UDim2.new(.5,0,1,-25),Vector2.new(.5,1),Color3.fromRGB(18,42,52),12)
local tipText=label(tip,"Message","COLLECT SCRAP  →  SELL AT THE REFINERY",UDim2.new(1,-22,1,-10),UDim2.fromOffset(11,5),Color3.fromRGB(240,253,247),Enum.Font.GothamBold,14)
tipText.TextWrapped=true
tipText.TextXAlignment=Enum.TextXAlignment.Center

local function refresh()
    carried.Text="SCRAP    " .. tostring(player:GetAttribute("SW_Carry") or 0) .. " / 5"
    local leaderstats=player:FindFirstChild("leaderstats")
    local cash=leaderstats and leaderstats:FindFirstChild("Cash")
    cashText.Text="CASH    $" .. tostring(cash and cash.Value or 0)
end
player:GetAttributeChangedSignal("SW_Carry"):Connect(refresh)
local function cashHook(child)
    if child.Name == "Cash" and child:IsA("IntValue") then
        child:GetPropertyChangedSignal("Value"):Connect(refresh)
        refresh()
    end
end
local function statsHook(statsFolder)
    for _, child in ipairs(statsFolder:GetChildren()) do cashHook(child) end
    statsFolder.ChildAdded:Connect(cashHook)
end
local currentStats=player:FindFirstChild("leaderstats")
if currentStats then statsHook(currentStats) end
player.ChildAdded:Connect(function(child)
    if child.Name == "leaderstats" then statsHook(child) end
end)

local toastId=0
local function notice()
    toastId+=1
    local mine=toastId
    local text=player:GetAttribute("SW_Notice") or "Collect scrap and sell it!"
    tipText.Text=text
    tip.BackgroundTransparency=.04
    tipText.TextTransparency=0
    task.delay(3.5,function()
        if mine~=toastId then return end
        TweenService:Create(tip,TweenInfo.new(.4),{BackgroundTransparency=.35}):Play()
        TweenService:Create(tipText,TweenInfo.new(.4),{TextTransparency=.2}):Play()
    end)
end
player:GetAttributeChangedSignal("SW_NoticeVersion"):Connect(notice)
refresh()
notice()
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>
