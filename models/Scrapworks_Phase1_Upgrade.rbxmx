    <Item class="ModuleScript" referent="RBX000000000000000000000000000001DF">
      <Properties>
        <string name="Name">Config</string>
        <ProtectedString name="Source"><![CDATA[-- Phase 1 / central economy and progression tuning
local Config = {}
Config.BagCapacity = 12
Config.ScrapRespawnSeconds = 9
Config.RefineryProcessingSeconds = 2.4
Config.CollectionRange = 12
Config.RefineryRange = 16
Config.MaterialOrder = {"Steel", "Aluminum", "Copper", "Battery", "Circuit", "Alloy"}
Config.Materials = {
    Steel = {Price = 15, Display = "STEEL"},
    Aluminum = {Price = 20, Display = "ALUMINUM"},
    Copper = {Price = 25, Display = "COPPER"},
    Battery = {Price = 32, Display = "BATTERY"},
    Circuit = {Price = 40, Display = "CIRCUIT"},
    Alloy = {Price = 55, Display = "ALLOY"},
}
return Config
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX000000000000000000000000000001E0">
      <Properties>
        <string name="Name">InventoryService</string>
        <ProtectedString name="Source"><![CDATA[-- Phase 1 / per-player material quantities. Session only; no DataStore yet.
local Inventory = {}
local items = {}
local Config = require(script.Parent.Config)
local function update(player)
    local data = items[player]
    if not data then return end
    local n, val = 0, 0
    for _, kind in ipairs(Config.MaterialOrder) do
        local qty = data[kind] or 0
        n += qty
        val += qty * Config.Materials[kind].Price
        player:SetAttribute("SW1_" .. kind, qty)
    end
    player:SetAttribute("SW1_Carry", n)
    player:SetAttribute("SW1_Value", val)
    player:SetAttribute("SW1_Capacity", Config.BagCapacity)
end
function Inventory.Init(player)
    if items[player] then return end
    local data = {}
    for _, kind in ipairs(Config.MaterialOrder) do data[kind] = 0 end
    items[player] = data
    update(player)
end
function Inventory.TryAdd(player, kind)
    if not Config.Materials[kind] then return false, "Unknown scrap type" end
    Inventory.Init(player)
    if Inventory.Total(player) >= Config.BagCapacity then
        return false, "BAG FULL! Visit the cyan refinery terminal."
    end
    items[player][kind] += 1
    update(player)
    return true
end
function Inventory.Total(player)
    local data = items[player]
    if not data then return 0 end
    local total = 0
    for _, kind in ipairs(Config.MaterialOrder) do total += data[kind] or 0 end
    return total
end
function Inventory.GetValue(player)
    local data = items[player]
    if not data then return 0 end
    local value = 0
    for _, kind in ipairs(Config.MaterialOrder) do
        value += (data[kind] or 0) * Config.Materials[kind].Price
    end
    return value
end
function Inventory.SellAll(player)
    local data = items[player]
    if not data then return 0, 0 end
    local qty = Inventory.Total(player)
    local value = Inventory.GetValue(player)
    for _, kind in ipairs(Config.MaterialOrder) do data[kind] = 0 end
    update(player)
    return qty, value
end
function Inventory.Release(player) items[player] = nil end
return Inventory
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX000000000000000000000000000001E1">
      <Properties>
        <string name="Name">EconomyService</string>
        <ProtectedString name="Source"><![CDATA[-- Phase 1 / centralized cash handling. Session-only during development.
local Economy = {}
function Economy.Init(player)
    local stats = player:FindFirstChild("leaderstats")
    if not stats then
        stats = Instance.new("Folder")
        stats.Name = "leaderstats"
        stats.Parent = player
    end
    local cash = stats:FindFirstChild("Cash")
    if not cash then
        cash = Instance.new("IntValue")
        cash.Name = "Cash"
        cash.Value = 0
        cash.Parent = stats
    end
    return cash
end
function Economy.Credit(player, amount)
    if typeof(amount) ~= "number" or amount < 0 or amount % 1 ~= 0 then return false end
    local cash = Economy.Init(player)
    cash.Value += amount
    return true
end
return Economy
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX000000000000000000000000000001E2">
      <Properties>
        <string name="Name">ScrapCollectionService</string>
        <ProtectedString name="Source"><![CDATA[-- Phase 1 / bind original and new scrap models to the same inventory service.
local Service = {}
local Config = require(script.Parent.Config)
local Inventory = require(script.Parent.InventoryService)
local function near(player, target, maxDist)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    return root and (root.Position - target.Position).Magnitude <= maxDist
end
function Service.Bind(container, notify)
    local bound = 0
    for _, node in ipairs(container:GetChildren()) do
        if node:IsA("Model") then
            local core = node:FindFirstChild("Core")
            local kind = string.match(node.Name, "^Scrap_(%a+)_")
            local item = kind and Config.Materials[kind]
            if core and core:IsA("BasePart") and item then
                for _, p in ipairs(core:GetChildren()) do
                    if p:IsA("ProximityPrompt") and (p.Name == "CollectScrap" or p.Name == "SW1_Collect") then
                        p:Destroy()
                    end
                end
                local prompt = Instance.new("ProximityPrompt")
                prompt.Name = "SW1_Collect"
                prompt.ObjectText = kind .. "  |  $" .. tostring(item.Price)
                prompt.ActionText = "Collect Scrap"
                prompt.KeyboardKeyCode = Enum.KeyCode.E
                prompt.HoldDuration = 0.2
                prompt.RequiresLineOfSight = false
                prompt.MaxActivationDistance = 9
                prompt.Parent = core
                local visuals = {}
                for _, part in ipairs(node:GetDescendants()) do
                    if part:IsA("BasePart") and not string.find(part.Name, "Pad") then
                        visuals[part] = {part.Transparency, part.CanCollide}
                    end
                end
                local cooling = false
                prompt.Triggered:Connect(function(player)
                    if cooling or not near(player, core, Config.CollectionRange) then return end
                    local ok, message = Inventory.TryAdd(player, kind)
                    if not ok then notify(player, message); return end
                    cooling = true
                    prompt.Enabled = false
                    for part, old in pairs(visuals) do
                        if part.Parent then part.Transparency = 1; part.CanCollide = false end
                    end
                    notify(player, "Collected " .. kind .. "  •  +$" .. tostring(item.Price) .. " sale value")
                    task.delay(Config.ScrapRespawnSeconds, function()
                        for part, old in pairs(visuals) do
                            if part.Parent then part.Transparency = old[1]; part.CanCollide = old[2] end
                        end
                        if prompt.Parent then prompt.Enabled = true end
                        cooling = false
                    end)
                end)
                bound += 1
            end
        end
    end
    return bound
end
return Service
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX000000000000000000000000000001E3">
      <Properties>
        <string name="Name">RefineryService</string>
        <ProtectedString name="Source"><![CDATA[-- Phase 1 / single authoritative sell interaction, 2.4-second processing cycle.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Config = require(script.Parent.Config)
local Inventory = require(script.Parent.InventoryService)
local Economy = require(script.Parent.EconomyService)
local Refinery = {}
local busy = {}
local function near(player, part)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    return root and (root.Position - part.Position).Magnitude <= Config.RefineryRange
end
function Refinery.Bind(terminal, indicators, notify)
    for _, p in ipairs(terminal:GetChildren()) do
        if p:IsA("ProximityPrompt") and (p.Name == "SellScrap" or p.Name == "SW1_Refine") then p:Destroy() end
    end
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = "SW1_Refine"
    prompt.ObjectText = "SCRAP REFINERY  |  PHASE 1"
    prompt.ActionText = "PROCESS & SELL"
    prompt.HoldDuration = 0.45
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.MaxActivationDistance = 12
    prompt.RequiresLineOfSight = false
    prompt.Parent = terminal
    prompt.Triggered:Connect(function(player)
        if busy[player] or not near(player, terminal) then return end
        if Inventory.Total(player) <= 0 then notify(player, "Bag empty! Find scrap marked by glowing pads."); return end
        busy[player] = true
        player:SetAttribute("SW1_Processing", true)
        notify(player, "REFINERY ACTIVE  •  Sorting and processing materials...")
        local pulse = 0
        for _, part in ipairs(indicators:GetChildren()) do
            if part:IsA("BasePart") then
                pulse += 1
                local delayTime = (pulse - 1) * 0.13
                task.delay(delayTime, function()
                    if part.Parent then
                        TweenService:Create(part,TweenInfo.new(.3),{Color=Color3.fromRGB(67,236,209)}):Play()
                        task.delay(.9,function()
                            if part.Parent then TweenService:Create(part,TweenInfo.new(.65),{Color=Color3.fromRGB(54,80,96)}):Play() end
                        end)
                    end
                end)
            end
        end
        task.delay(Config.RefineryProcessingSeconds,function()
            busy[player] = nil
            if player.Parent ~= Players then return end
            player:SetAttribute("SW1_Processing", false)
            if not near(player, terminal) then notify(player, "Processing canceled. Stay near the terminal."); return end
            local amount, value = Inventory.SellAll(player)
            if amount <= 0 then notify(player, "Your bag is empty."); return end
            if Economy.Credit(player, value) then
                notify(player, "SALE COMPLETE  •  " .. tostring(amount) .. " pieces  •  +$" .. tostring(value))
            end
        end)
    end)
    Players.PlayerRemoving:Connect(function(player) busy[player] = nil end)
end
return Refinery
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX000000000000000000000000000001E4">
      <Properties>
        <string name="Name">Phase1Bootstrap</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- SCRAPWORKS PHASE 1 | Non-destructive modular add-on for SCRAPWORKS_DEMO_V1
-- Import exactly once beside the original model under Workspace.
local Players = game:GetService("Players")
local Root = script.Parent
local Original = workspace:WaitForChild("SCRAPWORKS_DEMO_V1", 20)
if not Original then
    warn("[Scrapworks Phase1] Phase0 model missing. Import SCRAPWORKS_DEMO_V1 first.")
    return
end
-- Stop Phase0 gameplay scripts so two independent economies never run simultaneously.
local oldServer = Original:FindFirstChild("ScrapworksServer")
if oldServer and oldServer:IsA("Script") then oldServer.Disabled = true end
local oldHudTemplate = Original:FindFirstChild("ScrapworksHUD")
if oldHudTemplate and oldHudTemplate:IsA("LocalScript") then oldHudTemplate.Disabled = true end
local Config = require(Root:WaitForChild("Config"))
local Inventory = require(Root:WaitForChild("InventoryService"))
local Economy = require(Root:WaitForChild("EconomyService"))
local Collection = require(Root:WaitForChild("ScrapCollectionService"))
local Refinery = require(Root:WaitForChild("RefineryService"))

local function notify(player, message)
    player:SetAttribute("SW1_Notice", message)
    player:SetAttribute("SW1_NoticeSeq", (player:GetAttribute("SW1_NoticeSeq") or 0) + 1)
end
local function setup(player)
    if player:GetAttribute("SW1_Ready") then return end
    player:SetAttribute("SW1_Ready", true)
    Economy.Init(player)
    Inventory.Init(player)
    player:SetAttribute("SW1_Processing", false)
    local function installGui()
        local gui = player:WaitForChild("PlayerGui", 15)
        if not gui then return end
        -- Remove Phase0 HUD if its setup ran before this upgrade.
        local oldGuiScript = gui:FindFirstChild("ScrapworksHUD")
        if oldGuiScript then oldGuiScript:Destroy() end
        local oldHudScreen = gui:FindFirstChild("ScrapworksHUDScreen")
        if oldHudScreen then oldHudScreen:Destroy() end
        if not gui:FindFirstChild("ScrapworksPhase1HUD") then
            local template = Root:FindFirstChild("ScrapworksPhase1HUD")
            if template then template:Clone().Parent = gui end
        end
    end
    task.spawn(installGui)
    notify(player, "PHASE 1 ONLINE  •  Collect 6 kinds of scrap, then refine!")
end
Players.PlayerAdded:Connect(setup)
Players.PlayerRemoving:Connect(function(player) Inventory.Release(player) end)
for _,player in ipairs(Players:GetPlayers()) do task.spawn(setup,player) end

-- Remove Phase0 dynamically created prompts, regardless of script startup order.
local oldNodes = Original:FindFirstChild("ScrapNodes")
if oldNodes then
    for _,n in ipairs(oldNodes:GetDescendants()) do
        if n:IsA("ProximityPrompt") and n.Name == "CollectScrap" then n:Destroy() end
    end
end
local originalRefinery = Original:FindFirstChild("Refinery")
local terminal = originalRefinery and originalRefinery:FindFirstChild("SellTerminal")
if terminal then
    for _,n in ipairs(terminal:GetChildren()) do
        if n:IsA("ProximityPrompt") and n.Name == "SellScrap" then n:Destroy() end
    end
end
-- Open a visual corridor from the original yard to the freight annex.
local originalWorld = Original:FindFirstChild("Environment")
if originalWorld then
    for _,part in ipairs(originalWorld:GetChildren()) do
        if part:IsA("BasePart") and (part.Name == "SideBoundary" or part.Name == "FenceHorizontal" or part.Name == "FencePost") and part.Position.X > 40 then
            part.Transparency = 1
            part.CanCollide = false
        end
    end
end
if not oldNodes or not terminal then
    warn("[Scrapworks Phase1] Expected Phase0 scrap nodes/refinery are missing. Installation incomplete.")
    return
end
local nOld = Collection.Bind(oldNodes, notify)
local nNew = Collection.Bind(Root:WaitForChild("AdditionalScrapNodes"), notify)
Refinery.Bind(terminal, Root:WaitForChild("RefineryVisualEffects"), notify)

local function signage(part,caption,fg)
    local gui=Instance.new("SurfaceGui")
    gui.Name="SW1_Sign"
    gui.Face=Enum.NormalId.Front
    gui.PixelsPerStud=35
    gui.LightInfluence=0
    gui.Parent=part
    local l=Instance.new("TextLabel")
    l.BackgroundTransparency=1
    l.Size=UDim2.fromScale(1,1)
    l.Font=Enum.Font.GothamBlack
    l.TextScaled=true
    l.Text=caption
    l.TextColor3=fg
    l.TextStrokeTransparency=.2
    l.Parent=gui
end
local st=Root:FindFirstChild("FreightAnnex")
local structures=st and st:FindFirstChild("Structures")
local sg=structures and structures:FindFirstChild("SortingSign")
if sg then signage(sg,"SORTING & SALVAGE",Color3.fromRGB(94,240,222)) end
print("[Scrapworks Phase1] Upgrade active: "..tostring(nOld).." original nodes + "..tostring(nNew).." new nodes; "..tostring(#Config.MaterialOrder).." materials; bag capacity "..tostring(Config.BagCapacity))
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ScreenGui" referent="RBX000000000000000000000000000001E5">
      <Properties>
        <string name="Name">ScrapworksPhase1HUD</string>
        <bool name="ResetOnSpawn">false</bool>
        <bool name="IgnoreGuiInset">false</bool>
        <int name="DisplayOrder">20</int>
      </Properties>
      <Item class="LocalScript" referent="RBX000000000000000000000000000001E6">
        <Properties>
          <string name="Name">Phase1HUDController</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source"><![CDATA[-- SCRAPWORKS PHASE 1 | modern material inventory HUD (client only)
local Players=game:GetService("Players")
local TweenService=game:GetService("TweenService")
local player=Players.LocalPlayer
local gui=script.Parent
if not player then return end
local NAVY=Color3.fromRGB(14,31,43)
local PANEL=Color3.fromRGB(21,41,54)
local CYAN=Color3.fromRGB(78,239,222)
local CREAM=Color3.fromRGB(239,247,248)
local MUTE=Color3.fromRGB(146,184,196)
local GOLD=Color3.fromRGB(255,207,112)
local materialNames={"Steel","Aluminum","Copper","Battery","Circuit","Alloy"}
local materialColors={Steel=Color3.fromRGB(190,205,216),Aluminum=Color3.fromRGB(230,237,240),Copper=Color3.fromRGB(238,150,96),Battery=Color3.fromRGB(181,144,243),Circuit=Color3.fromRGB(132,236,160),Alloy=Color3.fromRGB(255,216,109)}
local function frame(parent,name,w,h,xs,xo,ys,yo,anchor,color)
    local f=Instance.new("Frame")
    f.Name=name
    f.Size=UDim2.fromOffset(w,h)
    f.Position=UDim2.new(xs,xo,ys,yo)
    f.AnchorPoint=anchor
    f.BackgroundColor3=color or PANEL
    f.BackgroundTransparency=.035
    f.BorderSizePixel=0
    f.Parent=parent
    local c=Instance.new("UICorner")
    c.CornerRadius=UDim.new(0,12)
    c.Parent=f
    local s=Instance.new("UIStroke")
    s.Thickness=1.2
    s.Color=Color3.fromRGB(65,116,134)
    s.Transparency=.32
    s.Parent=f
    return f
end
local function label(parent,name,text,w,h,x,y,color,size,bold)
    local t=Instance.new("TextLabel")
    t.Name=name
    t.Text=text
    t.Size=UDim2.fromOffset(w,h)
    t.Position=UDim2.fromOffset(x,y)
    t.BackgroundTransparency=1
    t.TextColor3=color or CREAM
    t.TextSize=size or 15
    t.Font=bold and Enum.Font.GothamBold or Enum.Font.Gotham
    t.TextXAlignment=Enum.TextXAlignment.Left
    t.TextYAlignment=Enum.TextYAlignment.Center
    t.Parent=parent
    return t
end
local banner=frame(gui,"Brand",296,47,0.5,0,0,20,Vector2.new(.5,0),NAVY)
local brandText=label(banner,"BrandText","SCRAPWORKS  /  PHASE 01",270,47,13,0,CYAN,18,true)
brandText.TextXAlignment=Enum.TextXAlignment.Center
local stats=frame(gui,"MaterialInventory",360,224,0,20,1,-20,Vector2.new(0,1),NAVY)
label(stats,"PanelTitle","MATERIAL INVENTORY",330,24,15,9,CYAN,13,true)
local qtyText=label(stats,"QtyText","0 / 12",100,26,265,9,CREAM,18,true)
qtyText.TextXAlignment=Enum.TextXAlignment.Right
local cashText=label(stats,"CashText","CASH   $0",260,31,15,37,GOLD,22,true)
local invGrid=Instance.new("Frame")
invGrid.Name="MaterialGrid"
invGrid.BackgroundTransparency=1
invGrid.Size=UDim2.new(1,-30,0,116)
invGrid.Position=UDim2.fromOffset(15,78)
invGrid.Parent=stats
local layout=Instance.new("UIGridLayout")
layout.CellSize=UDim2.new(.5,-5,0,34)
layout.CellPadding=UDim2.fromOffset(9,5)
layout.SortOrder=Enum.SortOrder.LayoutOrder
layout.Parent=invGrid
local rowLabels={}
for i,kind in ipairs(materialNames) do
    local pill=Instance.new("Frame")
    pill.LayoutOrder=i
    pill.BackgroundColor3=Color3.fromRGB(35,56,68)
    pill.BorderSizePixel=0
    pill.Parent=invGrid
    local c=Instance.new("UICorner")
    c.CornerRadius=UDim.new(0,7)
    c.Parent=pill
    local p=label(pill,"Name",string.upper(kind),116,32,9,0,materialColors[kind],11,true)
    local q=label(pill,"Quantity","0",29,32,125,0,CREAM,16,true)
    q.TextXAlignment=Enum.TextXAlignment.Right
    rowLabels[kind]=q
end
local footer=label(stats,"Footnote","6 materials  •  15+ salvage spots",329,22,15,194,MUTE,12,false)
local toast=frame(gui,"Toast",470,49,.5,0,1,-20,Vector2.new(.5,1),PANEL)
local toastText=label(toast,"ToastLabel","Collect scrap and process it at the refinery.",448,45,11,2,CREAM,14,true)
toastText.TextXAlignment=Enum.TextXAlignment.Center
toastText.TextWrapped=true
local progress=frame(gui,"ProcessPanel",300,57,.5,0,1,-89,Vector2.new(.5,1),NAVY)
progress.Visible=false
label(progress,"ProcessLabel","PROCESSING MATERIALS...",276,24,13,5,CYAN,13,true)
local track=Instance.new("Frame")
track.Name="Track"
track.Size=UDim2.fromOffset(276,9)
track.Position=UDim2.fromOffset(12,36)
track.BackgroundColor3=Color3.fromRGB(57,78,88)
track.BorderSizePixel=0
track.Parent=progress
local bar=Instance.new("Frame")
bar.Name="Fill"
bar.Size=UDim2.fromScale(0,1)
bar.BackgroundColor3=CYAN
bar.BorderSizePixel=0
bar.Parent=track
local c=Instance.new("UICorner") c.CornerRadius=UDim.new(1,0) c.Parent=track
local c2=Instance.new("UICorner") c2.CornerRadius=UDim.new(1,0) c2.Parent=bar
-- HUD scales down on smaller windows while staying anchored.
local screens={banner,stats,toast,progress}
local function fit()
    local camera=workspace.CurrentCamera
    if not camera then return end
    local size=camera.ViewportSize
    local scale=math.clamp(math.min(size.X/1200,size.Y/720),.64,1)
    for _,f in ipairs(screens) do
        local s=f:FindFirstChild("SW1_UIScale")
        if not s then s=Instance.new("UIScale") s.Name="SW1_UIScale" s.Parent=f end
        s.Scale=scale
    end
    if size.X < 800 then
        stats.Position=UDim2.new(0,10,1,-10)
        toast.Position=UDim2.new(.5,0,1,-10)
        progress.Position=UDim2.new(.5,0,1,-67)
    else
        stats.Position=UDim2.new(0,20,1,-20)
        toast.Position=UDim2.new(.5,0,1,-20)
        progress.Position=UDim2.new(.5,0,1,-89)
    end
end
local cam=workspace.CurrentCamera
if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit) end
fit()
local function refresh()
    qtyText.Text=tostring(player:GetAttribute("SW1_Carry") or 0).." / "..tostring(player:GetAttribute("SW1_Capacity") or 12)
    for _,kind in ipairs(materialNames) do rowLabels[kind].Text=tostring(player:GetAttribute("SW1_"..kind) or 0) end
    local statsObj=player:FindFirstChild("leaderstats")
    local cash=statsObj and statsObj:FindFirstChild("Cash")
    cashText.Text="CASH   $"..tostring(cash and cash.Value or 0)
end
for _,kind in ipairs(materialNames) do player:GetAttributeChangedSignal("SW1_"..kind):Connect(refresh) end
player:GetAttributeChangedSignal("SW1_Carry"):Connect(refresh)
player:GetAttributeChangedSignal("SW1_Capacity"):Connect(refresh)
local cashConn=nil
local function attachCash(statsObj)
    if not statsObj then return end
    local function attach(v)
        if v and v.Name=="Cash" and v:IsA("IntValue") then
            if cashConn then cashConn:Disconnect() end
            cashConn=v:GetPropertyChangedSignal("Value"):Connect(refresh)
            refresh()
        end
    end
    attach(statsObj:FindFirstChild("Cash"))
    statsObj.ChildAdded:Connect(attach)
end
attachCash(player:FindFirstChild("leaderstats"))
player.ChildAdded:Connect(function(v) if v.Name=="leaderstats" then attachCash(v) end end)
local noticeSeq=0
player:GetAttributeChangedSignal("SW1_NoticeSeq"):Connect(function()
    noticeSeq+=1
    local seq=noticeSeq
    toastText.Text=player:GetAttribute("SW1_Notice") or ""
    toast.BackgroundTransparency=.035
    toastText.TextTransparency=0
    task.delay(3.4,function()
        if seq~=noticeSeq then return end
        TweenService:Create(toast,TweenInfo.new(.35),{BackgroundTransparency=.38}):Play()
        TweenService:Create(toastText,TweenInfo.new(.35),{TextTransparency=.13}):Play()
    end)
end)
local currentTween=nil
player:GetAttributeChangedSignal("SW1_Processing"):Connect(function()
    if currentTween then currentTween:Cancel(); currentTween=nil end
    local processing=player:GetAttribute("SW1_Processing")
    progress.Visible=processing==true
    bar.Size=UDim2.fromScale(0,1)
    if processing then
        currentTween=TweenService:Create(bar,TweenInfo.new(2.4,Enum.EasingStyle.Linear),{Size=UDim2.fromScale(1,1)})
        currentTween:Play()
    end
end)
refresh()
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
