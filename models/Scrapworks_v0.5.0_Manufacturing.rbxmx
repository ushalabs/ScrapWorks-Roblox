    <Item class="ModuleScript" referent="RBX_SW_UNIFIED_00001034">
      <Properties>
        <string name="Name">Config</string>
        <ProtectedString name="Source">-- Scrapworks Phase 2: purchases and processor throughput. Prices are in session Cash.
local Config = {}
Config.Order = {"Compactor", "Sorter", "Smelter"}
Config.Machines = {
    Compactor = {Name="HYDRAULIC COMPACTOR", Cost=200, Multiplier=1.20, Minimum=3, Description="Press scrap into dense bundles", Tier=1},
    Sorter = {Name="OPTICAL SORTER", Cost=650, Multiplier=1.35, Minimum=5, Description="Sort and recover extra value", Tier=2},
    Smelter = {Name="INDUCTION SMELTER", Cost=1600, Multiplier=1.60, Minimum=8, Description="Refine scrap into high-value ingots", Tier=3},
}
return Config
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SW_UNIFIED_00001035">
      <Properties>
        <string name="Name">MachineService</string>
        <ProtectedString name="Source">-- Scrapworks Phase 2: server-only purchases and machine processing.
-- Uses Phase 1 InventoryService/EconomyService rather than replacing existing systems.
local Players=game:GetService("Players")
local TweenService=game:GetService("TweenService")
local Config=require(script.Parent.Config)
local Root=script.Parent
local Upgrade={}
local inventory, economy
local processing={}
local animating={}
local function animateStation(id)
    if animating[id] then return end
    local stations=Root:FindFirstChild("MachineStations")
    local station=stations and stations:FindFirstChild(id.."_Station")
    if not station then return end
    local part=station:FindFirstChild(id=="Compactor" and "CompressionPlateUpper" or (id=="Sorter" and "ScannerRail" or "HeatWindow"))
    if not part or not part:IsA("BasePart") then return end
    animating[id]=true
    if id=="Compactor" then
        local original=part.CFrame
        TweenService:Create(part,TweenInfo.new(.3,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{CFrame=original*CFrame.new(0,-1.3,0)}):Play()
        task.delay(.38,function()
            if part.Parent then TweenService:Create(part,TweenInfo.new(.6,Enum.EasingStyle.Back),{CFrame=original}):Play() end
        end)
    elseif id=="Sorter" then
        local original=part.Color
        TweenService:Create(part,TweenInfo.new(.3),{Color=Color3.fromRGB(245,252,255)}):Play()
        task.delay(.6,function()
            if part.Parent then TweenService:Create(part,TweenInfo.new(.6),{Color=original}):Play() end
        end)
    else
        local original=part.Transparency
        TweenService:Create(part,TweenInfo.new(.4),{Transparency=0}):Play()
        task.delay(.7,function()
            if part.Parent then TweenService:Create(part,TweenInfo.new(.6),{Transparency=original}):Play() end
        end)
    end
    task.delay(1.5,function()animating[id]=nil end)
end

local function notify(player,message)
    if player.Parent~=Players then return end
    player:SetAttribute("SW1_Notice",message)
    player:SetAttribute("SW1_NoticeSeq",(player:GetAttribute("SW1_NoticeSeq") or 0)+1)
end
function Upgrade.BindPhase1(phase1)
    inventory=require(phase1:WaitForChild("InventoryService"))
    economy=require(phase1:WaitForChild("EconomyService"))
end
function Upgrade.Init(player)
    for _,id in ipairs(Config.Order) do
        local key="SW2_Own_"..id
        if player:GetAttribute(key)==nil then player:SetAttribute(key,false) end
    end
    if player:GetAttribute("SW2_ActiveMachine")==nil then player:SetAttribute("SW2_ActiveMachine","") end
    player:SetAttribute("SW2_Ready",true)
end
local function has(player,id) return player:GetAttribute("SW2_Own_"..id)==true end
function Upgrade.Purchase(player,id)
    if player:GetAttribute("SW3_Loading") then return end
    if player.Parent~=Players or type(id)~="string" then return end
    local info=Config.Machines[id]
    if not info then return end
    if has(player,id) then notify(player,info.Name.." already unlocked!");return end
    local tier=info.Tier
    if tier&gt;1 and not has(player,Config.Order[tier-1]) then
        notify(player,"Unlock the previous machine first.");return
    end
    local cash=economy.Init(player)
    if cash.Value&lt;info.Cost then notify(player,"Need $"..tostring(info.Cost-cash.Value).." more to unlock "..info.Name);return end
    cash.Value-=info.Cost
    player:SetAttribute("SW2_Own_"..id,true)
    notify(player,"MACHINE UNLOCKED  •  "..info.Name.."! Visit its station in the freight annex.")
end
local function distanceOkay(player,part)
    local char=player.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    return root and root:IsA("BasePart") and (root.Position-part.Position).Magnitude&lt;=14
end
function Upgrade.Process(player,id,interactor)
    if player:GetAttribute("SW3_Loading") then return end
    if player.Parent~=Players or not distanceOkay(player,interactor) then return end
    local info=Config.Machines[id];if not info then return end
    if processing[player] then notify(player,"Machine is still cooling down.");return end
    if player:GetAttribute("SW1_Processing")==true then notify(player,"Wait for the refinery to finish.");return end
    if not has(player,id) then notify(player,"Unlock "..info.Name.." from the UPGRADES menu first.");return end
    local count=inventory.Total(player)
    if count&lt;info.Minimum then
        notify(player,"Need at least "..info.Minimum.." scrap pieces to use this machine.")
        return
    end
    -- Atomic within one server callback: no yields between SellAll and credit.
    local quantity, baseValue=inventory.SellAll(player)
    if quantity&lt;info.Minimum or baseValue&lt;=0 then return end
    local payout=math.floor(baseValue*info.Multiplier+.5)
    if not economy.Credit(player,payout) then
        warn("[Scrapworks Phase2] Unanticipated credit failure after consuming inventory for",player.UserId)
        return
    end
    processing[player]=true
    animateStation(id)
    player:SetAttribute("SW2_ActiveMachine",id)
    player:SetAttribute("SW2_LastSale",quantity.." items → $"..payout)
    notify(player,info.Name.."  •  "..quantity.." pieces processed  •  +$"..payout.."  ("..math.floor(info.Multiplier*100+.5).."% sale value)")
    task.delay(1.5,function()
        processing[player]=nil
        if player.Parent==Players then player:SetAttribute("SW2_ActiveMachine","") end
    end)
end
function Upgrade.Release(player) processing[player]=nil end
return Upgrade
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX_SW_UNIFIED_00001036">
      <Properties>
        <string name="Name">Phase2Bootstrap</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source">-- Scrapworks Phase 2: independent additive upgrade, import exactly once.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Root=script.Parent
local GameRoot=Root.Parent
if workspace:FindFirstChild("SCRAPWORKS_GAME")~=GameRoot then
    warn("[SW Phase2] Duplicate Phase2 add-on ignored. Remove extra copies from Workspace.")
    return
end
local phase1=GameRoot:WaitForChild("SCRAPWORKS_PHASE1_ADDON",20)
local phase0=GameRoot:WaitForChild("SCRAPWORKS_DEMO_V1",20)
if not phase1 or not phase0 then warn("[SW Phase2] Phase0 and Phase1 must be present before installing Phase2.");return end
local Config=require(Root:WaitForChild("Config"))
local Upgrade=require(Root:WaitForChild("MachineService"))
Upgrade.BindPhase1(phase1)
local remotes=Instance.new("Folder");remotes.Name="SW2_Remotes";remotes.Parent=Root
local purchaseRemote=Instance.new("RemoteEvent");purchaseRemote.Name="PurchaseMachine";purchaseRemote.Parent=remotes
local function setup(player)
    local limit=os.clock()+15
    while player.Parent==Players and not player:GetAttribute("SW1_Ready") and os.clock()&lt;limit do task.wait(.15) end
    if player.Parent~=Players then return end
    Upgrade.Init(player)
    local pg=player:WaitForChild("PlayerGui",15)
    if not pg then return end
    if not pg:FindFirstChild("ScrapworksPhase2HUD") then
        local template=Root:FindFirstChild("ScrapworksPhase2HUD")
        if template then template:Clone().Parent=pg end
    end
    player:SetAttribute("SW2_Notice","Machine upgrades available in the UPGRADES menu!")
end
Players.PlayerAdded:Connect(function(player)task.spawn(setup,player)end)
Players.PlayerRemoving:Connect(Upgrade.Release)
for _,player in ipairs(Players:GetPlayers()) do task.spawn(setup,player) end
local lastRequest={}
purchaseRemote.OnServerEvent:Connect(function(player,id)
    local now=os.clock()
    if now-(lastRequest[player] or -100)&lt;.35 then return end
    lastRequest[player]=now
    Upgrade.Purchase(player,id)
end)
Players.PlayerRemoving:Connect(function(p)lastRequest[p]=nil end)
local colors={Compactor=Color3.fromRGB(255,205,92),Sorter=Color3.fromRGB(83,241,229),Smelter=Color3.fromRGB(250,139,74)}
local stations=Root:WaitForChild("MachineStations")
local function makeSign(part,title,sub,color)
    local gui=Instance.new("SurfaceGui")
    gui.Name="MachineSign";gui.Face=Enum.NormalId.Back;gui.LightInfluence=0;gui.PixelsPerStud=45
    gui.Parent=part
    local f=Instance.new("Frame")
    f.BackgroundTransparency=1;f.Size=UDim2.fromScale(1,1);f.Parent=gui
    local l=Instance.new("TextLabel")
    l.BackgroundTransparency=1;l.Size=UDim2.fromScale(1,.58)
    l.Font=Enum.Font.GothamBlack;l.TextScaled=true;l.Text=title
    l.TextColor3=color;l.TextStrokeTransparency=.3;l.Parent=f
    local s=Instance.new("TextLabel")
    s.BackgroundTransparency=1;s.Position=UDim2.fromScale(0,.6);s.Size=UDim2.fromScale(1,.35)
    s.Font=Enum.Font.GothamBold;s.TextScaled=true;s.Text=sub
    s.TextColor3=Color3.fromRGB(240,249,252);s.Parent=f
end
for _,id in ipairs(Config.Order) do
    local info=Config.Machines[id]
    local machine=stations:FindFirstChild(id.."_Station")
    local interaction=machine and machine:FindFirstChild("MachineInteractor")
    if interaction then
        local screen=machine:FindFirstChild(id.."_Screen")
        if screen then makeSign(screen,info.Name,"+"..math.floor((info.Multiplier-1)*100+.5).."% VALUE  •  "..info.Minimum.." SCRAP",colors[id]) end
        local prompt=interaction:FindFirstChild("ProcessScrap") or Instance.new("ProximityPrompt")
        prompt.Name="ProcessScrap";prompt.ActionText="Process Scrap";prompt.ObjectText=info.Name
        prompt.KeyboardKeyCode=Enum.KeyCode.E;prompt.MaxActivationDistance=10
        prompt.HoldDuration=.4;prompt.RequiresLineOfSight=false;prompt.Parent=interaction
        prompt.Triggered:Connect(function(player)Upgrade.Process(player,id,interaction)end)
    else
        warn("[SW Phase2] Missing station:",id)
    end
end
print("[Scrapworks Unified] Machines initialized for factory game.")
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ScreenGui" referent="RBX_SW_UNIFIED_00001037">
      <Properties>
        <string name="Name">ScrapworksPhase2HUD</string>
        <bool name="ResetOnSpawn">false</bool>
        <bool name="IgnoreGuiInset">false</bool>
        <int name="DisplayOrder">30</int>
      </Properties>
      <Item class="LocalScript" referent="RBX_SW_UNIFIED_00001038">
        <Properties>
          <string name="Name">Phase2HUDController</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source">-- Scrapworks Phase 2 : optional machine shop + safe non-destructive Phase 1 HUD alignment fix.
local Players=game:GetService("Players")
local TweenService=game:GetService("TweenService")
local player=Players.LocalPlayer
if not player then return end
local gui=script.Parent
local gameRoot=workspace:WaitForChild("SCRAPWORKS_GAME")
local root=gameRoot:WaitForChild("SCRAPWORKS_PHASE2_ADDON")
local remotes=root:WaitForChild("SW2_Remotes")
local purchase=remotes:WaitForChild("PurchaseMachine")
local config=require(root:WaitForChild("Config"))
local NAVY=Color3.fromRGB(15,29,40)
local PANEL=Color3.fromRGB(24,45,59)
local LIGHT=Color3.fromRGB(241,249,249)
local MUTED=Color3.fromRGB(156,190,200)
local CYAN=Color3.fromRGB(79,239,219)
local GOLD=Color3.fromRGB(255,207,105)
local TINTS={Compactor=Color3.fromRGB(255,205,92),Sorter=Color3.fromRGB(81,228,220),Smelter=Color3.fromRGB(249,153,94)}
local function round(frame,r)
    local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,r or 10);c.Parent=frame
end
local function text(parent,name,txt,pos,size,font,color)
    local t=Instance.new("TextLabel")
    t.Name=name;t.BackgroundTransparency=1;t.Position=pos;t.Size=size
    t.Text=txt;t.Font=font or Enum.Font.Gotham;t.TextColor3=color or LIGHT
    t.TextSize=14;t.TextXAlignment=Enum.TextXAlignment.Left;t.TextYAlignment=Enum.TextYAlignment.Center
    t.Parent=parent;return t
end
local function action(parent,name,txt,pos,size,bg)
    local b=Instance.new("TextButton")
    b.Name=name;b.Text=txt;b.Position=pos;b.Size=size
    b.TextSize=14;b.Font=Enum.Font.GothamBold;b.TextColor3=LIGHT
    b.BorderSizePixel=0;b.BackgroundColor3=bg or PANEL
    b.AutoButtonColor=true;b.Parent=parent;round(b,10)
    return b
end

-- Bug fix: Phase1 header capacity counter extended past the inventory panel's right edge.
-- Keep existing Phase1 controller and stats; adjust only the counter and brand text.
task.spawn(function()
    local pg=player:WaitForChild("PlayerGui")
    local h=pg:WaitForChild("ScrapworksPhase1HUD",25)
    if not h then return end
    local inv=h:WaitForChild("MaterialInventory",15)
    if inv then
        local count=inv:WaitForChild("QtyText",10)
        if count then
            count.Position=UDim2.fromOffset(250,9)
            count.Size=UDim2.fromOffset(86,26)
            count.TextXAlignment=Enum.TextXAlignment.Right
            count.TextScaled=false
            count.TextSize=17
        end
    end
    local brand=h:FindFirstChild("Brand")
    local label=brand and brand:FindFirstChild("BrandText")
    if label then label.Text="SCRAPWORKS  /  FACTORY YARD" end
end)

local trigger=action(gui,"UpgradeToggle","⚙  UPGRADES",UDim2.new(1,-20,1,-22),UDim2.fromOffset(164,50),NAVY)
trigger.AnchorPoint=Vector2.new(1,1)
local stroke=Instance.new("UIStroke");stroke.Color=CYAN;stroke.Transparency=.35;stroke.Thickness=1.5;stroke.Parent=trigger
local frame=Instance.new("Frame")
frame.Name="MachineShop";frame.AnchorPoint=Vector2.new(.5,.5);frame.Position=UDim2.fromScale(.5,.5)
frame.Size=UDim2.fromOffset(570,465);frame.BackgroundColor3=NAVY;frame.BorderSizePixel=0
frame.Visible=false;frame.Parent=gui;round(frame,15)
local border=Instance.new("UIStroke");border.Color=Color3.fromRGB(83,134,147);border.Transparency=.25;border.Thickness=1.4;border.Parent=frame
local header=text(frame,"Title","MACHINE UPGRADES",UDim2.fromOffset(24,17),UDim2.fromOffset(440,34),Enum.Font.GothamBlack,CYAN)
header.TextSize=24
local subtitle=text(frame,"Subtitle","Spend CASH to unlock higher-value scrap processing.",UDim2.fromOffset(24,50),UDim2.fromOffset(470,27),Enum.Font.Gotham,MUTED)
subtitle.TextSize=13
local close=action(frame,"Close","✕",UDim2.new(1,-18,0,18),UDim2.fromOffset(37,37),Color3.fromRGB(51,68,79))
close.AnchorPoint=Vector2.new(1,0)
local line=Instance.new("Frame")
line.Position=UDim2.fromOffset(24,87);line.Size=UDim2.new(1,-48,0,1);line.BorderSizePixel=0
line.BackgroundColor3=Color3.fromRGB(68,103,119);line.Parent=frame
local cards={}
for i,id in ipairs(config.Order) do
    local info=config.Machines[id]
    local row=Instance.new("Frame")
    row.Name=id.."Card";row.Size=UDim2.new(1,-44,0,96)
    row.Position=UDim2.fromOffset(22,101+(i-1)*105)
    row.BackgroundColor3=PANEL;row.BorderSizePixel=0;row.Parent=frame;round(row,11)
    local strip=Instance.new("Frame");strip.Size=UDim2.fromOffset(5,74)
    strip.Position=UDim2.fromOffset(9,11);strip.BackgroundColor3=TINTS[id]
    strip.BorderSizePixel=0;strip.Parent=row;round(strip,3)
    local name=text(row,"MachineName",info.Name,UDim2.fromOffset(27,9),UDim2.fromOffset(285,23),Enum.Font.GothamBold,LIGHT)
    name.TextSize=17
    local desc=text(row,"Description",info.Description,UDim2.fromOffset(27,36),UDim2.fromOffset(330,20),Enum.Font.Gotham,MUTED)
    desc.TextSize=12
    local benefit=text(row,"Benefit","+"..math.floor((info.Multiplier-1)*100+.5).."% VALUE   •   "..info.Minimum.." SCRAP MIN",UDim2.fromOffset(27,62),UDim2.fromOffset(350,21),Enum.Font.GothamBold,TINTS[id])
    benefit.TextSize=12
    local buy=action(row,"Buy","$"..info.Cost,UDim2.new(1,-14,.5,0),UDim2.fromOffset(133,44),TINTS[id])
    buy.AnchorPoint=Vector2.new(1,.5)
    buy.TextColor3=NAVY
    buy.MouseButton1Click:Connect(function()purchase:FireServer(id)end)
    cards[id]={Button=buy,Info=info}
end
local footer=text(frame,"Footer","Collect scrap → Unlock a machine → Process your bag at its station.",UDim2.fromOffset(24,424),UDim2.new(1,-45,0,28),Enum.Font.Gotham,MUTED)
footer.TextSize=13
local scale=Instance.new("UIScale");scale.Name="FitScale";scale.Parent=frame
local tscale=Instance.new("UIScale");tscale.Name="ToggleScale";tscale.Parent=trigger
local function fit()
    local cam=workspace.CurrentCamera
    if not cam then return end
    local v=cam.ViewportSize
    scale.Scale=math.clamp(math.min((v.X-24)/570,(v.Y-24)/465),.55,1)
    tscale.Scale=math.clamp(math.min(v.X/1100,v.Y/690),.72,1)
end
if workspace.CurrentCamera then
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
end
fit()
local function refresh()
    for idx,id in ipairs(config.Order) do
        local x=cards[id]
        local owned=player:GetAttribute("SW2_Own_"..id)==true
        local required=idx&gt;1 and player:GetAttribute("SW2_Own_"..config.Order[idx-1])~=true
        local button=x.Button
        if owned then
            button.Text="✓ OWNED";button.BackgroundColor3=Color3.fromRGB(63,103,86);button.TextColor3=LIGHT
        elseif required then
            button.Text="LOCKED";button.BackgroundColor3=Color3.fromRGB(69,78,91);button.TextColor3=Color3.fromRGB(181,195,204)
        else
            button.Text="$"..x.Info.Cost;button.BackgroundColor3=TINTS[id];button.TextColor3=NAVY
        end
        button.Active=not (owned or required)
        button.AutoButtonColor=not (owned or required)
    end
end
for _,id in ipairs(config.Order) do player:GetAttributeChangedSignal("SW2_Own_"..id):Connect(refresh) end
refresh()
local function setVisible(value)
    frame.Visible=value
    trigger.Text=value and "✕  CLOSE" or "⚙  UPGRADES"
end
trigger.MouseButton1Click:Connect(function()setVisible(not frame.Visible)end)
close.MouseButton1Click:Connect(function()setVisible(false)end)
-- UI only; purchases are validated by the server.
</ProtectedString>
        </Properties>
      </Item>
    <Item class="LocalScript" referent="RBX_SW_UNIFIED_00001039">
        <Properties>
          <string name="Name">OwnedMachinePrompts</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source">-- Single-bundle machine prompts, client-visible only after actual purchase.
-- The server independently enforces distance, ownership, and inventory.
local Players=game:GetService("Players")
local localPlayer=Players.LocalPlayer
local gameRoot=workspace:WaitForChild("SCRAPWORKS_GAME",40)
if not gameRoot then return end
local phase2=gameRoot:WaitForChild("SCRAPWORKS_PHASE2_ADDON",30)
local stations=phase2 and phase2:WaitForChild("MachineStations",30)
if not stations then warn("[Scrapworks] Machine stations missing");return end
for _,id in ipairs({"Compactor","Sorter","Smelter"}) do
    task.spawn(function()
        local station=stations:WaitForChild(id.."_Station",30)
        local interact=station and station:WaitForChild("MachineInteractor",30)
        local prompt=interact and interact:WaitForChild("ProcessScrap",30)
        if not prompt then warn("[Scrapworks] Missing prompt for ",id);return end
        local key="SW2_Own_"..id
        local function refresh()
            prompt.Enabled=(localPlayer:GetAttribute(key)==true)
        end
        localPlayer:GetAttributeChangedSignal(key):Connect(refresh)
        refresh()
    end)
end
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
<Item class="Folder" referent="SW_PHASE3_0000001">
    <Properties>
      <string name="Name">ManufacturingV1</string>
    </Properties>
    <Item class="ModuleScript" referent="SW_PHASE3_0000002">
      <Properties>
        <string name="Name">Config</string>
        <ProtectedString name="Source">-- Phase 3 manufacturing and contract configuration: all rewards server validated.
local C={}
C.Outputs={"Plate","Wire","Motor"}
C.OutputNames={Plate="Steel Plate",Wire="Copper Wire",Motor="Electric Motor"}
C.Recipes={
    Plate={Name="PRESS STEEL PLATE",Raw={Steel=2},Goods={},Output="Plate",Amount=1,Seconds=6},
    Wire={Name="DRAW COPPER WIRE",Raw={Copper=2},Goods={},Output="Wire",Amount=1,Seconds=6},
    Motor={Name="ASSEMBLE ELECTRIC MOTOR",Raw={Circuit=1},Goods={Plate=1,Wire=1},Output="Motor",Amount=1,Seconds=12},
}
C.RecipeOrder={"Plate","Wire","Motor"}
C.Contracts={
    Framework={Name="BUILDING SUPPLY",Goods={Plate=2,Wire=1},Reward=240},
    CircuitRun={Name="ELECTRICAL ORDER",Goods={Wire=2},Reward=185},
    MotorOrder={Name="MOTOR DELIVERY",Goods={Motor=1},Reward=450},
}
C.ContractOrder={"Framework","CircuitRun","MotorOrder"}
return C
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="SW_PHASE3_0000003">
      <Properties>
        <string name="Name">ProductionService</string>
        <ProtectedString name="Source">-- Phase 3: server-side virtual production; never spawn physical items for every tick.
local Players=game:GetService("Players")
local Config=require(script.Parent.Config)
local P={};local states={};local inventory=nil;local economy=nil
local MAX_GOODS=9999
local function notice(player,message)
    if player.Parent~=Players then return end
    player:SetAttribute("SW1_Notice",message)
    player:SetAttribute("SW1_NoticeSeq",(player:GetAttribute("SW1_NoticeSeq") or 0)+1)
end
function P.Bind(phase1)
    inventory=require(phase1:WaitForChild("InventoryService"))
    economy=require(phase1:WaitForChild("EconomyService"))
end
local function refresh(player,data)
    if player.Parent~=Players then return end
    for _,id in ipairs(Config.Outputs) do player:SetAttribute("SW3_"..id,data.goods[id] or 0) end
    player:SetAttribute("SW3_Busy",data.pending~=nil)
    player:SetAttribute("SW3_Recipe",data.pending and data.pending.id or "")
    player:SetAttribute("SW3_FinishAt",data.pending and data.pending.finish or 0)
    player:SetAttribute("SW3_ContractsDone",data.contracts or 0)
    player:SetAttribute("SW3_Ready",true)
end
local function default()
    return {goods={Plate=0,Wire=0,Motor=0},contracts=0,pending=nil,started=false}
end
function P.Init(player)
    if not states[player] then states[player]=default() end
    refresh(player,states[player])
end
local function resolve(player)
    local d=states[player];if not d then return end
    if d.pending and os.time()&gt;=d.pending.finish then
        local id=d.pending.id;local recipe=Config.Recipes[id]
        if recipe then d.goods[recipe.Output]=math.min(MAX_GOODS,(d.goods[recipe.Output] or 0)+recipe.Amount) end
        d.pending=nil
        if player.Parent==Players then notice(player,recipe and ("MANUFACTURED  +"..recipe.Amount.." "..Config.OutputNames[recipe.Output]) or "Production finished") end
        refresh(player,d)
    end
end
local function near(player,part)
    local ch=player.Character;local pivot=ch and ch:FindFirstChild("HumanoidRootPart")
    return pivot and (pivot.Position-part.Position).Magnitude&lt;=20
end
local function canPay(d,goods)
    for id,count in pairs(goods) do
        if not table.find(Config.Outputs,id) or (d.goods[id] or 0)&lt;count then return false end
    end
    return true
end
function P.Craft(player,id,terminal)
    if player.Parent~=Players or not near(player,terminal) then return end
    if type(id)~="string" or not Config.Recipes[id] then return end
    if player:GetAttribute("SW3_Loading") then notice(player,"Loading factory data... try again.");return end
    P.Init(player);resolve(player)
    local d=states[player];local r=Config.Recipes[id]
    if d.pending then notice(player,"A machine job is already running.");return end
    if player:GetAttribute("SW1_Processing") or (player:GetAttribute("SW2_ActiveMachine") or "")~="" then
        notice(player,"Finish the current scrap process first.");return
    end
    if not inventory.CanConsume(player,r.Raw) or not canPay(d,r.Goods) then
        notice(player,"Missing materials. Collect scrap or manufacture prerequisites.");return
    end
    -- No yields between validation and inventory deductions, so one remote cannot race another.
    if not inventory.Consume(player,r.Raw) then return end
    for good,num in pairs(r.Goods) do d.goods[good]-=num end
    d.pending={id=id,finish=os.time()+r.Seconds}
    refresh(player,d)
    notice(player,"PRODUCTION STARTED  "..Config.OutputNames[r.Output].." · "..r.Seconds.."s")
    task.delay(r.Seconds+.25,function() if player.Parent==Players and states[player]==d then resolve(player) end end)
end
function P.Deliver(player,id,terminal)
    if player.Parent~=Players or not near(player,terminal) then return end
    if type(id)~="string" then return end
    local contract=Config.Contracts[id];if not contract then return end
    if player:GetAttribute("SW3_Loading") then return end
    P.Init(player);resolve(player)
    local d=states[player]
    if not canPay(d,contract.Goods) then notice(player,"Not enough manufactured goods for this contract.");return end
    for good,num in pairs(contract.Goods) do d.goods[good]-=num end
    d.contracts+=1
    economy.Credit(player,contract.Reward)
    refresh(player,d)
    notice(player,"CONTRACT COMPLETE  +$"..contract.Reward.."  ·  "..contract.Name)
end
function P.Export(player)
    if not states[player] then return nil end
    resolve(player)
    local d=states[player]
    local goods={};for _,id in ipairs(Config.Outputs) do goods[id]=d.goods[id] end
    local pending=d.pending and {id=d.pending.id,finish=d.pending.finish} or nil
    return {goods=goods,contracts=d.contracts,pending=pending}
end
function P.Import(player,record)
    if type(record)~="table" then return false end
    P.Init(player)
    local d=states[player]
    local goods={}
    for _,id in ipairs(Config.Outputs) do
        local q=type(record.goods)=="table" and record.goods[id] or 0
        if type(q)~="number" or q~=q or q&lt;0 then q=0 end
        goods[id]=math.floor(math.min(q,MAX_GOODS))
    end
    d.goods=goods
    local count=record.contracts
    d.contracts=(type(count)=="number" and math.floor(math.clamp(count,0,1000000))) or 0
    d.pending=nil
    local pending=record.pending
    if type(pending)=="table" and Config.Recipes[pending.id] and type(pending.finish)=="number" then
        d.pending={id=pending.id,finish=math.floor(math.min(os.time()+3600,math.max(os.time()-86400,pending.finish)))}
    end
    resolve(player);refresh(player,d)
    if d.pending then
        local remaining=math.max(0,d.pending.finish-os.time())
        task.delay(remaining+.3,function() if states[player]==d then resolve(player) end end)
    end
    return true
end
function P.Release(player) states[player]=nil end
return P
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="SW_PHASE3_0000004">
      <Properties>
        <string name="Name">Phase3Bootstrap</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source">-- Phase 3: single-root factory production, recipe authority, contract server.
local Players=game:GetService("Players")
local root=script.Parent
local world=root.Parent
assert(world.Name=="SCRAPWORKS_GAME","Phase3 requires unified model")
local phase1=world:WaitForChild("SCRAPWORKS_PHASE1_ADDON",30)
if not phase1 then error("Phase 1 inventory is required") end
local service=require(root:WaitForChild("ProductionService"))
service.Bind(phase1)
local remotes=Instance.new("Folder");remotes.Name="Remotes";remotes.Parent=root
local craft=Instance.new("RemoteEvent");craft.Name="Craft";craft.Parent=remotes
local deliver=Instance.new("RemoteEvent");deliver.Name="Deliver";deliver.Parent=remotes
local terminal=root:WaitForChild("ProductionTerminal"):WaitForChild("MainConsole")
local prompt=Instance.new("ProximityPrompt")
prompt.Name="ProductionAccess"
prompt.ActionText="Open Production"
prompt.ObjectText="FACTORY ASSEMBLY TERMINAL"
prompt.KeyboardKeyCode=Enum.KeyCode.E
prompt.MaxActivationDistance=12
prompt.HoldDuration=.25
prompt.RequiresLineOfSight=false
prompt.Parent=terminal
local last={}
local function setup(player)
    local deadline=os.clock()+20
    while player.Parent==Players and not player:GetAttribute("SW1_Ready") and os.clock()&lt;deadline do task.wait(.1) end
    if player.Parent~=Players then return end
    service.Init(player)
    local pg=player:WaitForChild("PlayerGui",15)
    local template=root:FindFirstChild("ManufacturingUI")
    if pg and template and not pg:FindFirstChild("ManufacturingUI") then template:Clone().Parent=pg end
end
Players.PlayerAdded:Connect(function(p) task.spawn(setup,p) end)
for _,p in ipairs(Players:GetPlayers()) do task.spawn(setup,p) end
craft.OnServerEvent:Connect(function(player,id)
    local now=os.clock();if now-(last[player] or -100)&lt;.3 then return end
    last[player]=now;service.Craft(player,id,terminal)
end)
deliver.OnServerEvent:Connect(function(player,id)
    local now=os.clock();if now-(last[player] or -100)&lt;.3 then return end
    last[player]=now;service.Deliver(player,id,terminal)
end)
Players.PlayerRemoving:Connect(function(p) last[p]=nil;task.delay(2,function()service.Release(p)end) end)
print("[Scrapworks v0.5] Manufacturing initialized: plates, wire, motors, contracts")
</ProtectedString>
      </Properties>
    </Item>
