    <Item class="ModuleScript" referent="RBX_SW_UNIFIED_00000953">
      <Properties>
        <string name="Name">Config</string>
        <ProtectedString name="Source">-- Phase 1 / central economy and progression tuning
local Config = {}
Config.BagCapacity = 12
Config.ScrapRespawnSeconds = 9
Config.RefineryProcessingSeconds = 2.4
Config.CollectionRange = 12
Config.RefineryRange = 16
Config.MaterialOrder = {"Steel", "Aluminum", "Copper", "Battery", "Circuit", "Alloy"}
Config.Materials = {
    Steel = {Price = 15, Display = "STEEL"},
    Aluminum = {Price = 20, Display = "ALUMINUM"},
    Copper = {Price = 25, Display = "COPPER"},
    Battery = {Price = 32, Display = "BATTERY"},
    Circuit = {Price = 40, Display = "CIRCUIT"},
    Alloy = {Price = 55, Display = "ALLOY"},
}
return Config
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SW_UNIFIED_00000954">
      <Properties>
        <string name="Name">InventoryService</string>
        <ProtectedString name="Source">-- Phase 1 / per-player material quantities. Session only; no DataStore yet.
local Inventory = {}
local items = {}
local Config = require(script.Parent.Config)
local function update(player)
    local data = items[player]
    if not data then return end
    local n, val = 0, 0
    for _, kind in ipairs(Config.MaterialOrder) do
        local qty = data[kind] or 0
        n += qty
        val += qty * Config.Materials[kind].Price
        player:SetAttribute("SW1_" .. kind, qty)
    end
    player:SetAttribute("SW1_Carry", n)
    player:SetAttribute("SW1_Value", val)
    player:SetAttribute("SW1_Capacity", Config.BagCapacity)
end
function Inventory.Init(player)
    if items[player] then return end
    local data = {}
    for _, kind in ipairs(Config.MaterialOrder) do data[kind] = 0 end
    items[player] = data
    update(player)
end
function Inventory.TryAdd(player, kind)
    if player:GetAttribute("SW3_Loading") then return false,"Loading your factory..." end
    if not Config.Materials[kind] then return false, "Unknown scrap type" end
    Inventory.Init(player)
    if Inventory.Total(player) &gt;= Config.BagCapacity then
        return false, "BAG FULL! Visit the cyan refinery terminal."
    end
    items[player][kind] += 1
    update(player)
    return true
end
function Inventory.Total(player)
    local data = items[player]
    if not data then return 0 end
    local total = 0
    for _, kind in ipairs(Config.MaterialOrder) do total += data[kind] or 0 end
    return total
end
function Inventory.GetValue(player)
    local data = items[player]
    if not data then return 0 end
    local value = 0
    for _, kind in ipairs(Config.MaterialOrder) do
        value += (data[kind] or 0) * Config.Materials[kind].Price
    end
    return value
end
function Inventory.SellAll(player)
    local data = items[player]
    if not data then return 0, 0 end
    local qty = Inventory.Total(player)
    local value = Inventory.GetValue(player)
    for _, kind in ipairs(Config.MaterialOrder) do data[kind] = 0 end
    update(player)
    return qty, value
end

-- Phase 3: atomic, non-yielding raw-material recipe consumption.
function Inventory.Count(player, kind)
    Inventory.Init(player)
    return (items[player] and items[player][kind]) or 0
end
function Inventory.CanConsume(player, ingredients)
    Inventory.Init(player)
    for kind,amount in pairs(ingredients) do
        if not Config.Materials[kind] or type(amount)~="number" or amount&lt;0 or amount%1~=0 then return false end
        if (items[player][kind] or 0)&lt;amount then return false end
    end
    return true
end
function Inventory.Consume(player, ingredients)
    if not Inventory.CanConsume(player,ingredients) then return false end
    for kind,amount in pairs(ingredients) do items[player][kind]-=amount end
    update(player)
    return true
end
function Inventory.Export(player)
    Inventory.Init(player)
    local record={}
    for _,kind in ipairs(Config.MaterialOrder) do record[kind]=items[player][kind] or 0 end
    return record
end
function Inventory.Import(player,record)
    Inventory.Init(player)
    if type(record)~="table" then return false end
    local clean={};local total=0
    for _,kind in ipairs(Config.MaterialOrder) do
        local q=record[kind]
        if type(q)~="number" or q~=q or q&lt;0 then q=0 end
        q=math.floor(math.min(q,Config.BagCapacity))
        clean[kind]=q;total+=q
    end
    if total&gt;Config.BagCapacity then return false end
    items[player]=clean;update(player)
    return true
end

function Inventory.Release(player) items[player] = nil end
return Inventory
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SW_UNIFIED_00000955">
      <Properties>
        <string name="Name">EconomyService</string>
        <ProtectedString name="Source">-- Phase 1 / centralized cash handling. Session-only during development.
local Economy = {}
function Economy.Init(player)
    local stats = player:FindFirstChild("leaderstats")
    if not stats then
        stats = Instance.new("Folder")
        stats.Name = "leaderstats"
        stats.Parent = player
    end
    local cash = stats:FindFirstChild("Cash")
    if not cash then
        cash = Instance.new("IntValue")
        cash.Name = "Cash"
        cash.Value = 0
        cash.Parent = stats
    end
    return cash
end
function Economy.Credit(player, amount)
    if typeof(amount) ~= "number" or amount &lt; 0 or amount % 1 ~= 0 then return false end
    local cash = Economy.Init(player)
    cash.Value += amount
    return true
end
return Economy
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SW_UNIFIED_00000956">
      <Properties>
        <string name="Name">ScrapCollectionService</string>
        <ProtectedString name="Source">-- Phase 1 / bind original and new scrap models to the same inventory service.
local Service = {}
local Config = require(script.Parent.Config)
local Inventory = require(script.Parent.InventoryService)
local function near(player, target, maxDist)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    return root and (root.Position - target.Position).Magnitude &lt;= maxDist
end
function Service.Bind(container, notify)
    local bound = 0
    for _, node in ipairs(container:GetChildren()) do
        if node:IsA("Model") then
            local core = node:FindFirstChild("Core")
            local kind = string.match(node.Name, "^Scrap_(%a+)_")
            local item = kind and Config.Materials[kind]
            if core and core:IsA("BasePart") and item then
                for _, p in ipairs(core:GetChildren()) do
                    if p:IsA("ProximityPrompt") and (p.Name == "CollectScrap" or p.Name == "SW1_Collect") then
                        p:Destroy()
                    end
                end
                local prompt = Instance.new("ProximityPrompt")
                prompt.Name = "SW1_Collect"
                prompt.ObjectText = kind .. "  |  $" .. tostring(item.Price)
                prompt.ActionText = "Collect Scrap"
                prompt.KeyboardKeyCode = Enum.KeyCode.E
                prompt.HoldDuration = 0.2
                prompt.RequiresLineOfSight = false
                prompt.MaxActivationDistance = 9
                prompt.Parent = core
                local visuals = {}
                for _, part in ipairs(node:GetDescendants()) do
                    if part:IsA("BasePart") and not string.find(part.Name, "Pad") then
                        visuals[part] = {part.Transparency, part.CanCollide}
                    end
                end
                local cooling = false
                prompt.Triggered:Connect(function(player)
                    if cooling or not near(player, core, Config.CollectionRange) then return end
                    local ok, message = Inventory.TryAdd(player, kind)
                    if not ok then notify(player, message); return end
                    cooling = true
                    prompt.Enabled = false
                    for part, old in pairs(visuals) do
                        if part.Parent then part.Transparency = 1; part.CanCollide = false end
                    end
                    notify(player, "Collected " .. kind .. "  •  +$" .. tostring(item.Price) .. " sale value")
                    task.delay(Config.ScrapRespawnSeconds, function()
                        for part, old in pairs(visuals) do
                            if part.Parent then part.Transparency = old[1]; part.CanCollide = old[2] end
                        end
                        if prompt.Parent then prompt.Enabled = true end
                        cooling = false
                    end)
                end)
                bound += 1
            end
        end
    end
    return bound
end
return Service
</ProtectedString>
