              <R00>1.00000000</R00>
              <R01>0.00000000</R01>
              <R02>0.00000000</R02>
              <R10>0.00000000</R10>
              <R11>1.00000000</R11>
              <R12>0.00000000</R12>
              <R20>-0.00000000</R20>
              <R21>0.00000000</R21>
              <R22>1.00000000</R22>
            </CoordinateFrame>
